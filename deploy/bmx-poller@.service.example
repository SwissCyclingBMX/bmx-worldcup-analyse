[Unit]
Description=BMX Poller (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bmx/bmx-worldcup-analyse
EnvironmentFile=/etc/bmx-pollers/%i.env
ExecStart=/opt/bmx/bmx-worldcup-analyse/.venv/bin/python /opt/bmx/bmx-worldcup-analyse/run_poller.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
