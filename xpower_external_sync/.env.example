# Copy this file to /opt/bmx/xpower-sync/.env on the VPS and fill the missing secrets.
# Do not commit the real .env.

# Local mirror paths
XPOWER_EXTSYNC_DB_PATH=/opt/bmx/xpower-sync/external_xpower.db
XPOWER_EXTSYNC_FILE_DIR=/opt/bmx/xpower-sync/files

# Target xPower archive import
XPOWER_ARCHIVE_DB_PATH=/opt/bmx/xpower-data/dev/xpower_archive.sqlite3
XPOWER_DATA_DIR=/opt/bmx/xpower-data/dev
XPOWER_CLI_IMPORT_PATH=/opt/bmx/bmx-xpower-lab/xpower_cli_import.py
XPOWER_CLI_PYTHON_PATH=/opt/bmx/bmx-xpower-lab/.venv/bin/python3

# Upstream Postgres (read-only source)
XPOWER_EXTSYNC_PG_HOST=aws-1-eu-central-2.pooler.supabase.com
XPOWER_EXTSYNC_PG_PORT=5432
XPOWER_EXTSYNC_PG_DB=postgres
XPOWER_EXTSYNC_PG_USER=postgres.rhzorylwzbyrhjuzhdol
XPOWER_EXTSYNC_PG_PASSWORD=PASTE_ME
XPOWER_EXTSYNC_PG_SSLMODE=require

# Keep the upstream query explicit so schema changes are visible.
XPOWER_EXTSYNC_PG_QUERY=SELECT t.*, u."username" AS user_name, l."location_name" AS location_name, y."training_typ" AS training_name FROM training_service.training t LEFT JOIN user_service.users u ON t."user_id" = u."id" LEFT JOIN training_service.location l ON t."location" = l."id" LEFT JOIN training_service.training_typ y ON t."training_typ" = y."id" WHERE t.deleted = FALSE;

# Upstream S3 storage (raw files)
XPOWER_EXTSYNC_S3_ENDPOINT=https://s3.swiss-backup02.infomaniak.com
XPOWER_EXTSYNC_S3_REGION=RegionOne
XPOWER_EXTSYNC_S3_BUCKET=default
XPOWER_EXTSYNC_S3_PREFIX=
XPOWER_EXTSYNC_S3_ACCESS_KEY_ID=PASTE_ME
XPOWER_EXTSYNC_S3_SECRET_ACCESS_KEY=PASTE_ME
XPOWER_EXTSYNC_S3_FORCE_PATH_STYLE=true
XPOWER_EXTSYNC_S3_SIGNATURE_VERSION=s3v4

# Optional: set this once you know which training column points to the raw file.
# Example values could be: force_data_path, s3_key, object_key, file_path, url
XPOWER_EXTSYNC_S3_OBJECT_KEY_FIELD=
